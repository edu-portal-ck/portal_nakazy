# Скопіюйте цей файл у .env (cp .env.example .env) і розкоментуйте потрібне.
# HTTP_PORT=80
# TIMEZONE=Europe/Kyiv
# INITIAL_ADMIN_PASSWORD=змініть-мене     (install.sh на новій установці сам згенерує й допише сюди пароль)

# --- HTTPS (README, розділ «HTTPS») ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# SITE_ADDRESS=192.168.1.100
# HTTPS_PORT=443
# CADDY_TLS=internal

# --- Копія в хмару (README, розділ «Копія в Google Диск») ---
# BACKUP_REMOTE=nakazy-crypt:
# BACKUP_KEEP_DAYS=30
