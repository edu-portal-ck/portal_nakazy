# Зразок налаштувань. Файл .env створює install.sh (туди ж — згенерований пароль адміністратора):
# відкрийте його (nano .env) і допишіть потрібні рядки звідси без «#». Копіювати цей файл поверх .env не можна —
# зітре пароль і налаштування HTTPS. Коментар пишіть окремим рядком, а не в рядку зі значенням.
# HTTP_PORT=80
# TIMEZONE=Europe/Kyiv
# Пароль початкового адміністратора (лише для порожньої бази; install.sh на новій установці генерує його сам):
# INITIAL_ADMIN_PASSWORD=змініть-мене

# --- HTTPS (README, розділ «HTTPS») ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# SITE_ADDRESS=192.168.1.100
# HTTPS_PORT=443
# CADDY_TLS=internal
# CADDY_VERSION=2.8

# --- Копія в хмару (README, розділ «Копія в Google Диск») ---
# BACKUP_REMOTE=nakazy-crypt:
# BACKUP_KEEP_DAYS=30
